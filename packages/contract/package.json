{
  "name": "@akimath/contract",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "types": "./src/index.ts",
  "description": "AkiMath cross-stack contract: the offline pack format, its canonicalizer and its emitted artifacts",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "dry": "jscpd src",
    "emit": "tsx src/adapters/emit.ts",
    "verify": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.0",
    "jscpd": "^5.0.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
