{
  "name": "akimath-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AkiMath backend API",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "dry": "jscpd src",
    "verify": "npm run typecheck && npm run test"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^3.0.0",
    "jscpd": "^5.0.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
