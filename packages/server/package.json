{
  "name": "@akimath/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AkiMath backend",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/main.ts",
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "mutation": "stryker run",
    "dry": "jscpd src",
    "verify": "npm run typecheck && npm run test",
    "migrate": "tsx --env-file-if-exists=.env.local src/cli/migrate.ts",
    "retention": "tsx --env-file-if-exists=.env.local src/cli/retention.ts",
    "schema:dump": "./scripts/dump-schema.sh"
  },
  "dependencies": {
    "@akimath/contract": "file:../contract",
    "@akimath/core": "file:../core",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.3",
    "jose": "6.2.9",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^3.0.0",
    "jscpd": "^5.0.15",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
