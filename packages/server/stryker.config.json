{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "vitest",
  "coverageAnalysis": "all",
  "mutate": [
    "src/**/*.ts",
    "!src/main.ts",
    "!src/adapters/**",
    "!src/cli/**"
  ],
  "reporters": [
    "clear-text",
    "progress",
    "html"
  ],
  "tempDirName": "tmp/stryker",
  "htmlReporter": {
    "fileName": "tmp/stryker/mutation.html"
  },
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 70
  }
}
