  "info": {
    "description": "The prompt travels rendered. The answer never travels online. Offline, a membership verifier travels and its verdict is provisional until sync.",
    "title": "AkiMath API",
    "version": "0.1.0"
  },
  "openapi": "3.0.3",
  "paths": {
    "/attempts": {
      "post": {
        "operationId": "submitAttempts",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AttemptBatch"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerdictBatch"
                }
              }
            },
            "description": "One verdict per attempt, in the order submitted."
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "The request was malformed."
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No valid session."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "description": "No such resource."
          }
        },
        "summary": "Submit a session's attempts and receive their verdicts."
      }
    },
